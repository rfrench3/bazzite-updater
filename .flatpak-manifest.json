{
    "id": "io.github.rfrench3.bazzite_updater",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.10",
    "sdk": "org.kde.Sdk",
    "command": "bazzite_updater",
    "tags": ["nightly"],
    "desktop-file-name-suffix": " (Nightly)",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--talk-name=org.freedesktop.Flatpak",
        "--device=input",
        "--filesystem=/usr/share/ublue-os/image-info.json:ro"
    ],
    "separate-locales": false,

    "modules": [
            {
            "name": "sdl3",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DSDL_STATIC=OFF",
                "-DSDL_SHARED=ON",
                "-DSDL_TEST_LIBRARY=OFF"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/libsdl-org/SDL.git",
                    "tag": "release-3.2.28"
                }
            ]
        },
        {
            "name": "bazzite_updater",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "sources": [ { "type": "dir", "path": ".", "skip": [".git"] } ]
        }
    ]
}

