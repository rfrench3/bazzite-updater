{
    "name": "Qt/KDE devcontainer",
    "image": "ghcr.io/rfrench3/qt6-kirigami-container:main",
    "remoteUser": "user",

    "containerEnv": {
        "WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}",
        "XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
        "XDG_SESSION_TYPE": "${localEnv:XDG_SESSION_TYPE}",
        "QML_IMPORT_PATH": "/workspaces/bazzite-updater/build/bin",
        "QML2_IMPORT_PATH": "/workspaces/bazzite-updater/build/bin",
    },
    "privileged": true,
    "mounts": [
        "source=${localEnv:XDG_RUNTIME_DIR},target=${localEnv:XDG_RUNTIME_DIR},type=bind,consistency=cached",
        "source=/usr/share/ublue-os/image-info.json,target=/run/host/usr/share/ublue-os/image-info.json,type=bind,consistency=cached",
        "source=/dev/input,target=/dev/input,type=bind",
    ],
}
